# Normalizacja tekstu w repozytorium; domyślnie LF w katalogu roboczym.
* text=auto eol=lf

# Kod i konfiguracja uruchamiane w kontenerach Linux.
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf

# Lokalne skrypty Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pliki binarne bez normalizacji, tekstowego diff i automatycznego scalania.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.7z binary
